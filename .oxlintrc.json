{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "ignorePatterns": ["src/api/gen/**", "src/routeTree.gen.ts", "dist/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/routes/**/*.tsx"],
      "rules": { "react/only-export-components": "off" }
    },
    {
      "files": ["src/player/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/**",
                  "../api/**",
                  "../../api/**",
                  "../routes/**",
                  "../../routes/**",
                  "../theme/**",
                  "../../theme/**",
                  "../lib/**",
                  "../../lib/**",
                  "../components/**",
                  "../../components/**",
                  "../hooks/**",
                  "../../hooks/**"
                ],
                "message": "src/player is app-agnostic: it must not import app modules (extract-ready boundary)."
              }
            ]
          }
        ]
      }
    }
  ]
}
